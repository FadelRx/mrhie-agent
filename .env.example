# Agent secrets — คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไม่ขึ้น git)
#   ค่าในไฟล์นี้ทับค่าใน config.json ตอน agent รัน — เก็บ "รหัส" ไว้ที่นี่ ไม่ใช่ใน config.json
#
# จำเป็น (secret):
HUB_API_KEY=PASTE_API_KEY_FROM_HUB
HOSXP_PASSWORD=CHANGE_ME
#
# ทางเลือก (ถ้าอยากเก็บไว้ใน env ด้วย — ไม่งั้นใส่ใน config.json ได้):
# HOSXP_HOST=10.0.0.9
# HOSXP_PORT=3306
# HOSXP_USER=readonly
# HOSXP_DB=hos
